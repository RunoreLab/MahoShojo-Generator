# Node runtime
NODE_ENV=development
# production / preview / local / test；部署与 fault-injection authority 不再从 NODE_ENV 推导。
HOSTED_API_ENVIRONMENT=local
HONO_HOST=0.0.0.0
HONO_PORT=8787
HONO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Arena Room HTTP/WSS 只接受调用者网页的精确 Origin；不得填写 wildcard 或 API hostname。
ARENA_ROOM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hono Arena Room runtime 的唯一 feature flag；false 可立即关闭 Room HTTP/WSS。
ARENA_MULTIPLAYER_ENABLED=false
HONO_AUTH_MODE=bearer

# Redis fixed-window rate limiting
REDIS_URL=redis://127.0.0.1:6379
# 本地 Docker Compose 必填，并同时用于 API 与 Redis 容器。
REDIS_PASSWORD=
REDIS_REQUIRED=false
# 多环境共用 Redis 时必须不同；生产留空，preview 使用 preview。
REDIS_KEY_PREFIX=

# D1 Gateway (preferred) or Cloudflare management API fallback
D1_REQUIRED=false
D1_GATEWAY_URL=http://127.0.0.1:8788
D1_GATEWAY_HMAC_SECRET=
# 只允许显式 local/test target 使用 loopback HTTP Gateway。
HOSTED_DR_LOCAL_FAULT_INJECTION=true

D1_GATEWAY_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Hosted generation and signatures
AI_PROVIDERS_CONFIG=[]
SIGNATURE_SECRET_KEY=
ARENA_FINALIZATION_URL=http://127.0.0.1:3000
ARENA_FINALIZATION_HMAC_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
# 可选：覆盖由 R2_ACCOUNT_ID 推导的 S3-compatible origin。
R2_ENDPOINT=
NEXT_PUBLIC_ENABLE_SENSITIVE_WORD_FILTER=true
NEXT_PUBLIC_ENABLE_AI_SAFETY_CHECK=false

# Hybrid compatibility mode only
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
