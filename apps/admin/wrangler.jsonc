{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mahoshojo-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "mahoshojo-admin-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../drizzle" }],
  "r2_buckets": [{"binding":"ADMIN_OBJECTS","bucket_name":"mahoshojo-admin-local"},{"binding":"LARGE_OBJECTS","bucket_name":"mahoshojo-large-objects-local"}],
  "queues": {"producers":[{"binding":"ADMIN_QUEUE","queue":"mahoshojo-admin-local"}],"consumers":[{"queue":"mahoshojo-admin-local","max_batch_size":5,"max_retries":3}]},
  "triggers": {"crons":["*/10 * * * *"]},
  // Safe local defaults. Deployment uses the reviewed private configuration;
  // production resource IDs and Access settings must be supplied explicitly.
  "vars": {
    "ADMIN_ACCESS_ISSUER": "https://unconfigured.cloudflareaccess.invalid",
    "ADMIN_ACCESS_AUDIENCE": "UNCONFIGURED_DENY_ALL",
    "ADMIN_ACCESS_JWKS_URL": "https://unconfigured.cloudflareaccess.invalid/cdn-cgi/access/certs",
    "ADMIN_PRINCIPALS_JSON": "[]"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
