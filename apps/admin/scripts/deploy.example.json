{
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "admin.mahoshojo.colanns.me", "custom_domain": true }],
  "vars": {
    "ADMIN_ACCESS_ISSUER": "https://synthetic-example.cloudflareaccess.com",
    "ADMIN_ACCESS_AUDIENCE": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "ADMIN_ACCESS_JWKS_URL": "https://synthetic-example.cloudflareaccess.com/cdn-cgi/access/certs",
    "ADMIN_PRINCIPALS_JSON": "[]",
    "ADMIN_ENABLED_ACTIONS": "[]"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "synthetic-example-admin",
    "database_id": "11111111-1111-1111-1111-111111111111"
  }],
  "r2_buckets": [
    { "binding": "ADMIN_OBJECTS", "bucket_name": "synthetic-example-admin-artifacts" },
    { "binding": "LARGE_OBJECTS", "bucket_name": "synthetic-example-large-objects" }
  ],
  "queues": {
    "producers": [{ "binding": "ADMIN_QUEUE", "queue": "synthetic-example-admin-jobs" }],
    "consumers": [{ "queue": "synthetic-example-admin-jobs", "max_batch_size": 5, "max_retries": 3 }]
  },
  "triggers": { "crons": ["*/10 * * * *"] }
}
