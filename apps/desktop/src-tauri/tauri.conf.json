{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MahoShojo Generator",
  "version": "0.1.0",
  "identifier": "me.colanns.mahoshojo.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run generate:notices:rust && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main-ui",
        "title": "MahoShojo Generator",
        "width": 1180,
        "height": 800,
        "minWidth": 800,
        "minHeight": 450,
        "preventOverflow": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "capabilities": [
        "main-ui"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1ODYyOUI0NEI1OTY4MTUKUldRVmFGbEx0Q21HUmNrYXBBVEdtSGRDT1BoUEVTWFlZekkxTmJpVmd3V09NRUNqN0xoVHQ5NWUK",
      "endpoints": [
        "https://mahoshojo.colanns.me/desktop/updates/stable/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
