FROM node:22-alpine AS dependencies
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
# Phase 2.5 legacy-root 临时策略；apps/api 激活后改为复制其实际 workspace 依赖闭包。
COPY apps/d1-gateway/package.json ./apps/d1-gateway/package.json
COPY packages/ai-core/package.json ./packages/ai-core/package.json
COPY packages/ai-direct/package.json ./packages/ai-direct/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/hosted-api/package.json ./packages/hosted-api/package.json
COPY packages/hosted-runtime/package.json ./packages/hosted-runtime/package.json
COPY packages/local-library/package.json ./packages/local-library/package.json
COPY packages/multiplayer-core/package.json ./packages/multiplayer-core/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
COPY . .
RUN pnpm run build:server

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/dist/server ./dist/server
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist/server/index.mjs"]
