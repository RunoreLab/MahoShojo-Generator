# 修改为 .env.local 来使用捏

# AI 提供商配置（JSON 格式）
# 按顺序配置多个提供商，每个配置一个模型
AI_PROVIDERS_CONFIG='[
  {
    "name": "gemini_primary",
    "apiKey": "your_gemini_api_key_here",
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "model": ["gemini-2.0-flash", "gemini-1.5-pro", "gemini-1.5-flash"],
    "type": "google",
    "weight": 3,
    "retryCount": 2,
    "skipProbability": 0
  },
  {
    "name": "openai_provider",
    "apiKey": "your_openai_api_key_here",
    "baseUrl": "https://api.openai.com/v1",
    "model": ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo"],
    "type": "openai",
    "weight": 2,
    "retryCount": 1,
    "skipProbability": 0.1,
    "mode": "json"
  },
  {
    "name": "siliconflow_provider",
    "apiKey": "your_siliconflow_api_key_here",
    "baseUrl": "https://api.siliconflow.cn/v1",
    "model": [
      "deepseek-ai/DeepSeek-V3.2",
      "zai-org/GLM-5",
      "zai-org/GLM-4.6",
      "Qwen/Qwen3-32B",
      "moonshotai/Kimi-K2-Instruct-0905"
    ],
    "type": "openai",
    "weight": 2,
    "retryCount": 1,
    "skipProbability": 0.1,
    "mode": "auto"
  },
  {
    "name": "backup_gemini",
    "apiKey": "your_backup_gemini_key",
    "baseUrl": "https://backup-api.com/v1",
    "model": "gemini-1.5-flash",
    "type": "google",
    "weight": 1,
    "retryCount": 1,
    "skipProbability": 0.3
  }
]'

# 原生数据验证功能：HMAC签名的密钥配置
SIGNATURE_SECRET_KEY="在这里填写一个长且随机的安全密钥"

# (可选) 内容安全配置
# v0.2.1 版本引入了灵活的AI内容安全检查策略，可通过环境变量进行配置：

NEXT_PUBLIC_SAFETY_CHECK_POLICY='{"character":"none","scenario":"non-native-only","userGuidance":"all"}'
NEXT_PUBLIC_ENABLE_BUNDLE_SAFETY_CHECK=true
NEXT_PUBLIC_AI_SAFETY_PROMPT_LEVEL=moderate

# Sensitive Word Filter Settings
# 设置为 'true' 以开启拼音检测，设置为 'false' 或留空则关闭。
NEXT_PUBLIC_ENABLE_PINYIN_CHECK=true

# 战报生成记录：output_preview 的存储策略
# 已迁移到 `config/battle-report.ts`：
# - persistPreviewInD1（默认 true）
# - outputPreviewMode（默认 full，可设 truncate）
# 当 mode=truncate 或 full 超出 maxStoreChars 时使用的头尾长度（按字符数）
BATTLE_REPORT_OUTPUT_PREVIEW_HEAD_CHARS=800
BATTLE_REPORT_OUTPUT_PREVIEW_TAIL_CHARS=800
# 流式输出在内存中最多保留多少字符用于写入 output_preview（超出则退化为 head/tail 拼接）
BATTLE_REPORT_OUTPUT_PREVIEW_MAX_STORE_CHARS=2000000
# 省略号（可选）
BATTLE_REPORT_OUTPUT_PREVIEW_ELLIPSIS=……

# 流式读取超时（毫秒）
# - idle：reader.read() 最长等待多久没有新 chunk 就判定超时（用于前端/后端读流）
# - total：整段流式生成允许的最长总时长（用于前端/后端读流）
NEXT_PUBLIC_STREAM_READ_IDLE_TIMEOUT_MS=300000
NEXT_PUBLIC_STREAM_READ_TOTAL_TIMEOUT_MS=600000

# Arena 流式生成中止快速收尾（默认开启；紧急回退时设为 false）
ARENA_ABORT_FAST_PATH=true

# AI负载均衡配置
# 负载均衡策略: sequential(顺序) | random(随机) | round_robin(轮询)
AI_LOAD_BALANCE_STRATEGY=random

# Cloudflare D1 数据库配置
# Hono 服务生产环境优先配置 D1_GATEWAY_URL；以下管理 API 凭据仅用于迁移脚本和过渡回退。
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
D1_DATABASE_ID=your_d1_database_id_here

# 独立 Hono 服务
HONO_HOST=0.0.0.0
HONO_PORT=8787
HONO_CORS_ORIGINS=http://localhost:3000
# bearer：Hono 仅接受 Authorization: Bearer <用户 authkey>，不初始化 Better Auth。
# hybrid：兼容 Better Auth session 与 Bearer authkey，适合 Next/Cloudflare 主站。
HONO_AUTH_MODE=bearer
# 生产环境建议均为 true；开发环境可设 false 以允许依赖降级。
REDIS_REQUIRED=true
D1_REQUIRED=true

# Redis（密码中的特殊字符必须进行 URL 编码）
REDIS_URL=redis://default:replace_with_redis_password@127.0.0.1:6379
# 也可不用 REDIS_URL，改用以下字段；服务会自动 URL 编码密码。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace_with_redis_password
# REDIS_TLS=false

# D1 Gateway（生产推荐）
D1_GATEWAY_URL=https://d1-gateway.example.com
# Hono 与 Gateway 两侧配置同一个 32+ 字节随机密钥；不得使用示例值。
D1_GATEWAY_HMAC_SECRET=replace_with_a_long_random_gateway_secret
# 可选：使用固定 Bearer token 代替 HMAC；生产不建议同时省略两者。
D1_GATEWAY_TOKEN=
# 可选：Gateway 受 Cloudflare Access 保护时配置 Service Token。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Cloudflare R2（可选，用于大对象外部化存储，如战报全文）
# - 仅当你启用/使用 R2 相关脚本或功能时需要配置；未配置时会回退到 D1（或仅保留摘要）
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
# （可选）若未提供，将使用 CLOUDFLARE_ACCOUNT_ID 推导
R2_ACCOUNT_ID=your_r2_account_id_here
# （可选）自定义 endpoint，默认：https://<accountId>.r2.cloudflarestorage.com
R2_ENDPOINT=

NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 用户系统的验证码服务
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# Resend 邮件服务
RESEND_API_KEY=your_resend_api_key_here

# Better Auth（Next/Cloudflare 主站或 HONO_AUTH_MODE=hybrid 时启用；Hono bearer 模式无需配置）
# 建议使用 32+ 长度随机字符串（可用 openssl rand -base64 32 生成）
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# 可选；不填时将尝试从请求推断 baseURL（建议生产环境显式配置）
BETTER_AUTH_URL=http://localhost:8787
# 可选；逗号分隔的受信任来源（跨域场景建议显式配置）
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
