# 原生数据验证功能：HMAC签名的密钥配置
SIGNATURE_SECRET_KEY="在这里填写一个长且随机的安全密钥"

# (可选) 内容安全配置
# v0.2.1 版本引入了灵活的AI内容安全检查策略，可通过环境变量进行配置：

NEXT_PUBLIC_SAFETY_CHECK_POLICY='{"character":"none","scenario":"non-native-only","userGuidance":"all"}'
NEXT_PUBLIC_ENABLE_BUNDLE_SAFETY_CHECK=true
NEXT_PUBLIC_AI_SAFETY_PROMPT_LEVEL=moderate

# Sensitive Word Filter Settings
# 设置为 'true' 以开启拼音检测，设置为 'false' 或留空则关闭。
NEXT_PUBLIC_ENABLE_PINYIN_CHECK=true

# 战报生成记录：output_preview 的存储策略
# 已迁移到 `config/battle-report.ts`：
# - persistPreviewInD1（默认 true）
# - outputPreviewMode（默认 full，可设 truncate）
# 当 mode=truncate 或 full 超出 maxStoreChars 时使用的头尾长度（按字符数）
BATTLE_REPORT_OUTPUT_PREVIEW_HEAD_CHARS=800
BATTLE_REPORT_OUTPUT_PREVIEW_TAIL_CHARS=800
# 流式输出在内存中最多保留多少字符用于写入 output_preview（超出则退化为 head/tail 拼接）
BATTLE_REPORT_OUTPUT_PREVIEW_MAX_STORE_CHARS=2000000
# 省略号（可选）
BATTLE_REPORT_OUTPUT_PREVIEW_ELLIPSIS=……

# 流式读取超时（毫秒）
# - idle：reader.read() 最长等待多久没有新 chunk 就判定超时（用于前端/后端读流）
# - total：整段流式生成允许的最长总时长（用于前端/后端读流）
NEXT_PUBLIC_STREAM_READ_IDLE_TIMEOUT_MS=150000
NEXT_PUBLIC_STREAM_READ_TOTAL_TIMEOUT_MS=600000

# Arena 流式生成中止快速收尾（默认开启；紧急回退时设为 false）
ARENA_ABORT_FAST_PATH=true

# AI负载均衡配置
# 负载均衡策略: sequential(顺序) | random(随机) | round_robin(轮询)
AI_LOAD_BALANCE_STRATEGY=random

# Cloudflare D1 数据库配置
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
D1_DATABASE_ID=your_d1_database_id_here

# Cloudflare R2（可选，用于大对象外部化存储，如战报全文）
# - 仅当你启用/使用 R2 相关脚本或功能时需要配置；未配置时会回退到 D1（或仅保留摘要）
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
# （可选）若未提供，将使用 CLOUDFLARE_ACCOUNT_ID 推导
R2_ACCOUNT_ID=your_r2_account_id_here
# （可选）自定义 endpoint，默认：https://<accountId>.r2.cloudflarestorage.com
R2_ENDPOINT=

NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 用户系统的验证码服务
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# Resend 邮件服务
RESEND_API_KEY=your_resend_api_key_here

# Better Auth（已默认启用）
# 建议使用 32+ 长度随机字符串（可用 openssl rand -base64 32 生成）
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# 可选；不填时将尝试从请求推断 baseURL（建议生产环境显式配置）
BETTER_AUTH_URL=http://localhost:3000
# 可选；逗号分隔的受信任来源（跨域场景建议显式配置）
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
