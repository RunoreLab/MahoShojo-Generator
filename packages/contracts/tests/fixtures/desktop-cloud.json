    "not-authenticated",
    "flow-not-found",
    "flow-in-progress",
    "cancelled",
    "timeout",
    "state-mismatch",
    "protocol-mismatch",
    "network-error",
    "server-unavailable",
    "invalid-response",
    "storage-unavailable",
    "internal-error"
  ],
  "hostedGenerationEventNames": [
    "markdown",
    "reasoning",
    "reasoning_done",
    "telemetry",
    "done",
    "error"
  ],
