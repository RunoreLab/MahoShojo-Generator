{
  "protocolVersion": "desktop-auth-v1",
  "paths": {
    "authorize": "/auth/desktop",
    "grant": "/api/auth/native/grant",
    "exchange": "/api/auth/native/exchange",
    "getSession": "/api/auth/get-session",
    "signOut": "/api/auth/sign-out",
    "meProfile": "/api/me/profile",
    "hostedDrReadiness": "/api/hosted/dr-readiness",
    "hostedGenerateDetailsStream": "/api/generate-magical-girl-details-stream",
    "hostedGenerateDetails": "/api/generate-magical-girl-details",
    "hostedGenerateCanshouStream": "/api/generate-canshou-stream",
    "hostedGenerateCanshou": "/api/generate-canshou",
    "loopbackCallback": "/callback"
  },
  "limits": {
    "maxStateLength": 128,
    "codeLength": 43,
    "codeChallengeLength": 43,
    "minCodeVerifierLength": 43,
    "maxCodeVerifierLength": 128,
    "grantTtlSeconds": 120
  },
  "authErrorCodes": [
    "invalid-request",
    "unauthorized",
    "invalid-grant",
    "protocol-mismatch",
    "rate-limited",
    "account-unavailable",
    "internal-error"
  ],
  "ipcErrorCodes": [
    "not-authenticated",
    "flow-not-found",
    "flow-in-progress",
    "cancelled",
    "timeout",
    "state-mismatch",
    "protocol-mismatch",
    "network-error",
    "server-unavailable",
    "invalid-response",
    "storage-unavailable",
    "invalid-request",
    "internal-error"
  ],
  "hostedGenerationEventNames": [
    "markdown",
    "reasoning",
    "reasoning_done",
    "telemetry",
    "done",
    "error"
  ],
  "hostedGenerationRouteIds": [
    "generate-magical-girl-details-stream",
    "generate-canshou-stream"
  ],
  "hostedJsonRouteIds": [
    "generate-magical-girl-details",
    "generate-canshou"
  ],
  "cardLibrary": {
    "routes": {
      "data-cards.query": { "method": "GET", "path": "/api/data-cards", "auth": "required" },
      "data-cards.create": { "method": "POST", "path": "/api/data-cards", "auth": "required" },
      "favorites.query": { "method": "GET", "path": "/api/favorites", "auth": "required" },
      "favorites.add": { "method": "POST", "path": "/api/favorites", "auth": "required" },
      "favorites.remove": { "method": "DELETE", "path": "/api/favorites", "auth": "required" },
      "decks.query": { "method": "GET", "path": "/api/decks", "auth": "required" },
      "deck-cards.query": { "method": "GET", "path": "/api/deck-cards", "auth": "required" },
      "public-data-cards.query": { "method": "GET", "path": "/api/public-data-cards", "auth": "optional" },
      "tags.query": { "method": "GET", "path": "/api/tags", "auth": "optional" },
      "data-card-stats.report": { "method": "POST", "path": "/api/data-card-stats", "auth": "optional" },
      "data-card-meta-batch.query": { "method": "POST", "path": "/api/data-card-meta-batch", "auth": "optional" },
      "badges-batch.query": { "method": "POST", "path": "/api/badges/batch", "auth": "optional" }
    }
  },
  "validRedirectUris": [
    "http://127.0.0.1:1/callback",
    "http://127.0.0.1:45231/callback",
    "http://127.0.0.1:65535/callback",
    "http://[::1]:8080/callback"
  ],
  "invalidRedirectUris": [
    "https://127.0.0.1:45231/callback",
    "http://localhost:45231/callback",
    "http://127.0.0.1:45231/callback?x=1",
    "http://127.0.0.1:45231/other",
    "http://127.0.0.1:45231/callback#frag",
    "http://evil.example.com:45231/callback",
    "http://127.0.0.1:0/callback",
    "http://user@127.0.0.1:45231/callback",
    "mahoshojo://callback",
    "http://127.0.0.1/callback/extra"
  ],
