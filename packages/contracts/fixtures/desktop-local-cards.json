    "invalid-document",
    "document-too-large",
    "index-mismatch",
    "record-tombstoned",
    "transition-mismatch",
    "record-missing",
    "non-monotonic-timestamp",
    "invalid-query",
    "maintenance-busy",
    "store-failure"
  ],
  "cardTypes": ["character", "scenario", "history", "questionnaire"],
  "blobErrorCodes": [
    "blob-unavailable",
    "blob-digest-mismatch",
    "blob-corrupt",
    "blob-too-large",
    "blob-not-found",
    "blob-failure"
  ],
  "blobWriteOutcomes": ["stored", "alreadyPresent", "repaired"],
  "maxPackageArchiveBytes": 67108864,
  "webPackageIndex": {
    "id": "wp_0123456789abcdef0123456789abcdef",
