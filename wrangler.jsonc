{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahoshojo-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mahoshojo-next"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahoshojo",
      "database_id": "0175bc65-b160-49e4-b0d2-ef3f97827ea2",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "production": {
      "name": "mahoshojo-next",
      "compatibility_date": "2024-09-23",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "mahoshojo-next"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mahoshojo",
          "database_id": "0175bc65-b160-49e4-b0d2-ef3f97827ea2",
          "migrations_dir": "drizzle"
        }
      ]
    },
    "preview": {
      "name": "mahoshojo-next-preview",
      "compatibility_date": "2024-09-23",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "mahoshojo-next-preview"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mahoshojo",
          "database_id": "0175bc65-b160-49e4-b0d2-ef3f97827ea2",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
