/node_modules
apps/*/node_modules/
packages/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/out/

# production
/build
/dist
apps/*/dist/
packages/*/dist/
apps/*/coverage/
apps/*/build/
apps/*/out/
