packages/*/build/
packages/*/out/
packages/*/.open-next/


# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wrangler
.wrangler/

# IDEs and editors
.idea/

# Doccuments
/docs/temp
/docs/logs
