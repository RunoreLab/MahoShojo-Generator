{
  "id": "terrorinfinity-fx-v137",
  "version": "1.0.0",
  "title": "无限恐怖FXv137 标准人物卡",
  "description": "基于无限恐怖FXv137 标准人物卡的轻量车卡规则，覆盖九项属性、十二项技能、体积、基础衍生值与初始专长预算。",
  "supportedTemplates": ["general", "magical-girl", "canshou"],
  "allowStandalone": true,
  "mainRuleEligible": true,
  "projectionPolicy": "primary-structured",
