      "type": "stat-array",
      "label": "九项属性",
      "description": "初始属性基本值为 1，按 3/2/1+3 分配后的最终值；首版以总属性点预算校验为主。",
      "fields": [
        { "id": "INT", "label": "智力", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "PER", "label": "感知", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "RES", "label": "决心", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "STR", "label": "力量", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "DEX", "label": "敏捷", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "STA", "label": "耐力", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "PRE", "label": "风度", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "MAN", "label": "操控", "min": 1, "max": 5, "defaultValue": 1 },
        { "id": "COM", "label": "沉着", "min": 1, "max": 5, "defaultValue": 1 }
      ]
    },
    {
