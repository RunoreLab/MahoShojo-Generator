      "fields": [
        { "id": "academics", "label": "学识", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "devices", "label": "器用", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "craft", "label": "手艺", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "focus", "label": "专注", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "athletics", "label": "运动", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "survival", "label": "生存", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "firearms", "label": "射击", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "combat", "label": "武技", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "insight", "label": "洞察", "min": 0, "max": 4, "defaultValue": 0 },
        { "id": "stealth", "label": "隐秘", "min": 0, "max": 4, "defaultValue": 0 },
