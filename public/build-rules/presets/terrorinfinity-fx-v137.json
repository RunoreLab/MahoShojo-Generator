        {
          "id": "general",
          "label": "一般专长",
          "items": [
            { "id": "lucky-star-1", "label": "幸运星 1", "cost": 1, "description": "偏向机运骰、剧情奖励或类似检定的幸运型专长。" },
            { "id": "iron-will-1", "label": "钢铁意志 1", "cost": 1, "description": "强化承压、坚持与意志相关表现。" },
            { "id": "sharp-senses-1", "label": "敏锐感官 1", "cost": 1, "description": "强化感知危险、搜索和反应。" }
          ]
        }
      ]
    },
    {
      "id": "derivedStats",
      "type": "derived",
      "label": "基础衍生值",
      "description": "运行时会根据力量、敏捷、耐力、感知、决心、沉着与体积生成速度、先攻、基础防御、生命值和意志力。"
    },
    {
      "id": "ruleNotice",
      "type": "section",
      "label": "规则说明",
      "description": "本版以无限恐怖FXv137 标准人物卡为主，覆盖初始卡常用字段；专业明细、攻击预设、防御预设、超凡属性、超凡技能、血统、装备与完整强化树仍建议写入自由描述或后续专门规则块。"
