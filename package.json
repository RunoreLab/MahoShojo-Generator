{
    "name": "mahoshojo-generator",
    "version": "0.8.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:pretty": "next dev --turbopack | pino-pretty",
        "build": "next build",
        "check:naming": "node scripts/check-naming-conventions.mjs --report-only",
        "check:naming:strict": "node scripts/check-naming-conventions.mjs",
        "check:wrangler:d1": "node scripts/check-wrangler-d1-config.mjs",
        "build:cf": "node scripts/check-wrangler-d1-config.mjs && node scripts/build-cf.mjs",
        "preview": "npm run build:cf && wrangler pages dev .vercel/output/static",
        "start": "next start",
        "lint": "next lint",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "backfill:user-auth-links:dry": "bun scripts/backfill-user-auth-links.ts --dry-run true --batch 200",
        "backfill:user-auth-links:write": "bun scripts/backfill-user-auth-links.ts --write --batch 200",
        "snapshot:user-analytics:daily": "bun scripts/snapshot-admin-user-analytics-daily.ts",
        "snapshot:user-analytics:trigger": "node scripts/trigger-admin-user-analytics-snapshot.mjs",
        "db:migrate:local:prod": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --local --env production",
        "db:migrate:remote:prod": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --remote --env production",
        "db:migrate:local:preview": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --local --env preview",
        "db:migrate:remote:preview": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --remote --env preview",
        "db:status:remote:prod": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-release-status.mjs --database DB --remote --env production",
        "db:status:remote:prod:ready": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-release-status.mjs --database DB --remote --env production --require-ready",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "dependencies": {
        "@ai-sdk/deepseek": "^1.0.31",
        "@ai-sdk/google": "^2.0.45",
        "@ai-sdk/openai": "^2.0.80",
        "@ai-sdk/react": "^2.0.109",
        "@hookform/resolvers": "^5.2.2",
        "@next/third-parties": "15.3.8",
        "@tanstack/react-query": "^5.90.12",
        "@types/mdast": "^4.0.4",
        "@zumer/snapdom": "^1.9.7",
        "ai": "^5.0.108",
        "aws4fetch": "^1.0.20",
        "better-auth": "^1.4.19",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.1",
        "esbuild": "^0.27.2",
        "fflate": "^0.8.2",
        "jieba-wasm": "^2.4.0",
        "jsonrepair": "^3.13.1",
        "katex": "^0.16.27",
        "lucide-react": "^0.511.0",
        "mdast-util-from-markdown": "^2.0.2",
        "mdast-util-math": "^3.0.0",
        "micromark-extension-math": "^3.1.0",
        "next": "15.3.8",
        "pino": "^9.7.0",
        "pinyin-pro": "^3.27.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-hook-form": "^7.68.0",
        "react-markdown": "^10.1.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "string-random": "^0.1.3",
        "tailwind-merge": "^3.3.0",
        "tsx": "^4.21.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0",
        "zod": "^4.1.13",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@cloudflare/next-on-pages": "^1.13.13",
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/typescript-estree": "^8.43.0",
        "drizzle-kit": "^0.31.9",
        "eslint": "^9",
        "eslint-config-next": "15.3.2",
        "shadcn": "^3.5.2",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.3.0",
        "typescript": "^5",
        "wrangler": "^4.28.0"
    }
}
