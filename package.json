{
    "name": "mahoshojo-generator",
    "version": "0.8.2",
    "private": true,
    "packageManager": "pnpm@11.3.0",
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:server": "node scripts/generate-hono-route-manifest.mjs && tsx watch server/index.ts",
        "dev:d1-gateway": "pnpm --filter @mahoshojo/d1-gateway run dev",
        "dev:pretty": "bash -lc 'if command -v pino-pretty >/dev/null 2>&1; then next dev --turbopack | pino-pretty; else echo \"[dev:pretty] pino-pretty 未安装，回退到原始日志输出\" >&2; next dev --turbopack; fi'",
        "clean:next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
        "build": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && next build",
        "check:naming": "node scripts/check-naming-conventions.mjs --report-only",
        "check:naming:strict": "node scripts/check-naming-conventions.mjs",
        "check:naming:workspace": "node scripts/check-naming-conventions.mjs --workspace-only",
        "check:wrangler:d1": "node scripts/check-wrangler-d1-config.mjs",
        "build:cf": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && node scripts/check-wrangler-d1-config.mjs && opennextjs-cloudflare build",
        "preview": "pnpm run build:cf && opennextjs-cloudflare preview",
        "deploy": "pnpm run build:cf && opennextjs-cloudflare deploy",
        "start": "next start",
        "start:server": "node dist/server/index.mjs",
        "build:server": "node scripts/generate-hono-route-manifest.mjs && node scripts/build-hono-server.mjs",
        "server:routes": "node scripts/generate-hono-route-manifest.mjs",
        "verify:server:runtime": "node scripts/verify-hono-runtime.mjs",
        "deploy:d1-gateway": "pnpm --filter @mahoshojo/d1-gateway run deploy",
        "lint": "next lint",
        "check:workspace:boundaries": "node scripts/check-workspace-boundaries.mjs",
        "workspace:test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" --if-present run test",
        "workspace:lint": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" --if-present run lint",
        "workspace:build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" --if-present run build",
        "workspace:verify": "pnpm run check:workspace:boundaries && pnpm run check:naming:workspace && pnpm run workspace:test && pnpm run workspace:lint && pnpm run workspace:build",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "backfill:user-auth-links:dry": "pnpm exec tsx scripts/backfill-user-auth-links.ts --dry-run true --batch 200",
        "backfill:user-auth-links:write": "pnpm exec tsx scripts/backfill-user-auth-links.ts --write --batch 200",
        "db:migrate:local:prod": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --local --env production",
        "db:migrate:remote:prod": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --remote --env production",
        "db:migrate:local:preview": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --local --env preview",
        "db:migrate:remote:preview": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-migrate-safe.mjs --database DB --remote --env preview",
        "db:status:remote:prod": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-release-status.mjs --database DB --remote --env production",
        "db:status:remote:prod:ready": "node scripts/check-wrangler-d1-config.mjs && node scripts/d1-release-status.mjs --database DB --remote --env production --require-ready",
        "test": "vitest run",
        "test:server": "vitest run tests/server",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@mahoshojo/ai-core": "workspace:*",
        "@mahoshojo/contracts": "workspace:*",
        "@mahoshojo/domain": "workspace:*",
        "@ai-sdk/deepseek": "^2.0.35",
        "@ai-sdk/google": "^3.0.75",
        "@ai-sdk/openai": "^3.0.64",
        "@ai-sdk/react": "^3.0.186",
        "@hono/node-server": "^2.1.1",
        "@hookform/resolvers": "^5.2.2",
        "@next/third-parties": "15.5.21",
        "@opennextjs/cloudflare": "^1.20.2",
        "@tanstack/react-query": "^5.90.12",
        "@types/mdast": "^4.0.4",
        "@zumer/snapdom": "^1.9.7",
        "ai": "^6.0.184",
        "aws4fetch": "^1.0.20",
        "better-auth": "~1.6.30",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "esbuild": "^0.28.1",
        "fflate": "^0.8.2",
        "hono": "^4.13.3",
        "jieba-wasm": "^2.4.0",
        "jsonrepair": "^3.13.1",
        "katex": "^0.16.27",
        "lucide-react": "^0.511.0",
        "mdast-util-from-markdown": "^2.0.2",
        "mdast-util-math": "^3.0.0",
        "micromark-extension-math": "^3.1.0",
        "next": "15.5.21",
        "pino": "^9.7.0",
        "pinyin-pro": "^3.27.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-hook-form": "^7.68.0",
        "react-markdown": "^10.1.0",
        "redis": "^6.2.1",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "string-random": "^0.1.3",
        "styled-jsx": "5.1.6",
        "tailwind-merge": "^3.3.0",
        "tsx": "^4.21.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0",
        "zod": "^4.1.13",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@next/env": "15.5.21",
        "@tailwindcss/postcss": "^4",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/parser": "^8.50.0",
        "@typescript-eslint/typescript-estree": "^8.43.0",
        "better-sqlite3": "^12.10.0",
        "comment-json": "4.2.5",
        "drizzle-kit": "^0.31.9",
        "eslint": "^9",
        "eslint-config-next": "15.5.21",
        "fake-indexeddb": "^6.2.5",
        "shadcn": "^3.5.2",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.3.0",
        "typescript": "^5",
        "vitest": "^4.1.7",
        "wrangler": "^4.125.0"
    }
}
