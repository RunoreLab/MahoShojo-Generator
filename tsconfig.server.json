{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "incremental": false,
    "plugins": [],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "lib/**/*.ts",
    "app/api/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    ".next",
    "node_modules",
    "tests",
    "scripts"
  ]
}
